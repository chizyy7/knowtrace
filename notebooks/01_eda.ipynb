 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# KnowTrace Exploratory Data Analysis\\n",
    "\\n",
    "This notebook performs exploratory data analysis on the ASSISTments 2009-2010 skill-builder dataset or synthetic fallback data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import necessary libraries\\n",
    "import pandas as pd\\n",
    "import numpy as np\\n",
    "import matplotlib.pyplot as plt\\n",
    "import seaborn as sns\\n",
    "import json\\n",
    "from pathlib import Path\\n",
    "\\n",
    "# Set plotting style\\n",
    "plt.style.use('seaborn-v0_8')\\n",
    "sns.set_palette(\"husl\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check if processed data exists, otherwise generate synthetic\\n",
    "from knowtrace.data.load import generate_synthetic\\n",
    "from knowtrace.data.preprocess import preprocess, PreprocessConfig\\n",
    "\\n",
    "processed_dir = Path(\"data/processed\")\\n",
    "if not processed_dir.exists() or not any(processed_dir.iterdir()):\\n",
    "    print(\"Processed data not found. Generating synthetic data...\")\\n",
    "    # Generate synthetic data\\n",
    "    raw_dir = Path(\"data/raw\")\\n",
    "    raw_dir.mkdir(parents=True, exist_ok=True)\\n",
    "    raw_path = raw_dir / \"skill_builder_data.csv\"\\n",
    "    if not raw_path.exists():\\n",
    "        df_synthetic = generate_synthetic(seed=42)\\n",
    "        df_synthetic.to_csv(raw_path, index=False)\\n",
    "        print(f\"Synthetic data saved to {raw_path}\")\\n",
    "    \\n",
    "    # Run preprocessing\\n",
    "    config = PreprocessConfig(seed=42)\\n",
    "    processed_sequences, id_maps = preprocess(config)\\n",
    "    print(\"Preprocessing completed.\")\\n",
    "else:\\n",
    "    print(\"Found existing processed data.\")\\n",
    "    # Load ID maps\\n",
    "    with open(processed_dir / \"id_maps.json\", 'r') as f:\\n",
    "        id_maps = json.load(f)\\n",
    "    # Load sequences\\n",
    "    from knowtrace.data.dataset import load_sequences\\n",
    "    train_sequences = load_sequences(processed_dir / \"train.jsonl\")\\n",
    "    val_sequences = load_sequences(processed_dir / \"val.jsonl\")\\n",
    "    test_sequences = load_sequences(processed_dir / \"test.jsonl\")\\n",
    "    processed_sequences = {\\n",
    "        'train': train_sequences,\\n",
    "        'val': val_sequences,\\n",
    "        'test': test_sequences\\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic statistics\\n",
    "all_sequences = processed_sequences['train'] + processed_sequences['val'] + processed_sequences['test']\\n",
    "\\n",
    "seq_lengths = [len(seq['q_ids']) for seq in all_sequences]\\n",
    "n_users = len(all_sequences)\\n",
    "total_interactions = sum(seq_lengths)\\n",
    "\\n",
    "print(f\"Number of users: {n_users}\")\\n",
    "print(f\"Total interactions: {total_interactions}\")\\n",
    "print(f\"Mean sequence length: {np.mean(seq_lengths):.2f}\")\\n",
    "print(f\"Median sequence length: {np.median(seq_lengths):.2f}\")\\n",
    "print(f\"Min sequence length: {np.min(seq_lengths)}\")\\n",
    "print(f\"Max sequence length: {np.max(seq_lengths)}\")\\n",
    "\\n",
    "# Correctness rate\\n",
    "all_corrects = [c for seq in all_sequences for c in seq['corrects']]\\n",
    "correctness_rate = np.mean(all_corrects)\\n",
    "print(f\"Overall correctness rate: {correctness_rate:.3f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot sequence length distribution\\n",
    "plt.figure(figsize=(10, 6))\\n",
    "plt.hist(seq_lengths, bins=30, alpha=0.7, edgecolor='black')\\n",
    "plt.xlabel('Sequence Length')\\n",
    "plt.ylabel('Number of Users')\\n",
    "plt.title('Distribution of User Sequence Lengths')\\n",
    "plt.grid(True, alpha=0.3)\\n",
    "plt.tight_layout()\\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    # Analyze skill and problem statistics\\n",
    "# Flatten all skills and problems across sequences\\n",
    "all_skills = [skill for seq in all_sequences for skill in seq['skill_ids']]\\n",
    "all_problems = [problem for seq in all_sequences for problem in seq['q_ids']]\\n",
    "\\n",
    "unique_skills = len(set(all_skills))\\n",
    "unique_problems = len(set(all_problems))\\n",
    "\\n",
    "print(f\"Unique skills: {unique_skills}\")\\n",
    "print(f\"Unique problems: {unique_problems}\")\\n",
    "",
    "# Skill frequency\\n",
    "from collections import Counter\\n",
    "skill_counts = Counter(all_skills)\\n",
    "most_common_skills = skill_counts.most_common(10)\\n",
    "",
    "plt.figure(figsize=(12, 6))\\n",
    "skills, counts = zip(*most_common_skills)\\n",
    "plt.bar(range(len(skills)), counts)\\n",
    "plt.xlabel('Skill ID')\\n",
    "plt.ylabel('Frequency')\\n",
    "plt.title('Top 10 Most Frequent Skills')\\n",
    "plt.xticks(range(len(skills)), [f'S{s}' for s in skills], rotation=45)\\n",
    "plt.tight_layout()\\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    # Per-skill accuracy\\n",
    "skill_correct = {}\\n",
    "skill_total = {}\\n",
    "",
    "for seq in all_sequences:\\n",
    "    for skill_id, correct in zip(seq['skill_ids'], seq['corrects']):\\n",
    "        if skill_id not in skill_correct:\\n",
    "            skill_correct[skill_id] = 0\\n",
    "            skill_total[skill_id] = 0\\n",
    "        skill_correct[skill_id] += correct\\n",
    "        skill_total[skill_id] += 1\\n",
    "",
    "skill_accuracies = {}\\n",
    "for skill_id in skill_total:\\n",
    "    if skill_total[skill_id] > 0:\\n",
    "        skill_accuracies[skill_id] = skill_correct[skill_id] / skill_total[skill_id]\\n",
    "",
    "accuracies_list = list(skill_accuracies.values())\\n",
    "",
    "plt.figure(figsize=(10, 6))\\n",
    "plt.hist(accuracies_list, bins=20, alpha=0.7, edgecolor='black')\\n",
    "plt.xlabel('Skill Accuracy')\\n",
    "plt.ylabel('Number of Skills')\\n",
    "plt.title('Distribution of Per-Skill Accuracy')\\n",
    "plt.axvline(np.mean(accuracies_list), color='red', linestyle='--', label=f'Mean: {np.mean(accuracies_list):.3f}')\\n",
    "plt.legend()\\n",
    "plt.grid(True, alpha=0.3)\\n",
    "plt.tight_layout()\\n",
    "plt.show()\\n",
    "",
    "print(f\"Mean skill accuracy: {np.mean(accuracies_list):.3f}\")\\n",
    "print(f\"Std skill accuracy: {np.std(accuracies_list):.3f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    # Verify no user overlap between splits\\n",
    "train_users = set(seq['user_id'] for seq in processed_sequences['train'])\\n",
    "val_users = set(seq['user_id'] for seq in processed_sequences['val'])\\n",
    "test_users = set(seq['user_id'] for seq in processed_sequences['test'])\\n",
    "",
    "overlap_train_val = train_users.intersection(val_users)\\n",
    "overlap_train_test = train_users.intersection(test_users)\\n",
    "overlap_val_test = val_users.intersection(test_users)\\n",
    "",
    "print(f\"Train-Val overlap: {len(overlap_train_val)} users\")\\n",
    "print(f\"Train-Test overlap: {len(overlap_train_test)} users\")\\n",
    "print(f\"Val-Test overlap: {len(overlap_val_test)} users\")\\n",
    "",
    "if len(overlap_train_val) == 0 and len(overlap_train_test) == 0 and len(overlap_val_test) == 0:\\n",
    "    print(\"✓ No user overlap detected between splits - good!\")\\n",
    "else:\\n",
    "    print(\"✗ User overlap detected - potential data leakage!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Summary\\n",
    "\\n",
    "This EDA notebook provides insights into the dataset characteristics:\\n",
    "- Sequence length distribution helps determine appropriate max_len parameter\\n",
    "- Skill and problem frequency identifies rare entities that may need special handling\\n",
    "- Per-skill accuracy shows the variability in difficulty across concepts\\n",
    "- Verification of train/val/test split integrity ensures no user leakage\\n",
    "\\n",
    "Next steps: Proceed to BKT baseline implementation (Phase 2)."
   ]
  }
 ],
